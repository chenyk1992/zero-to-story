# Local tool installations and the unintegrated, local-only video-talkcraft package.
/.local-tools/
/.agents/skills/video-talkcraft/

# Local iteration plans, maintenance notes and retrospectives.
# Durable user/Agent documentation is tracked in guides/.
# docs/agents/ holds per-repo configuration read by the engineering skills and
# must ship with the repo; everything else under docs/ stays local.
/docs/*
!/docs/agents/

# Node
node_modules/

# OS
.DS_Store
Thumbs.db

# Local secrets / env
.env
.env.local
.env.*
!.env.example
/.lfo/
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
.git.source/
*.log

# Agent scratch
.superpowers/

.codex-mimo/
pipeline_run.log

# Temporary prompt / scratch text files at the repo root
tmp_*.txt

# Throwaway storyboard image at the repo root
/storyboard-bw-*.jpg

# Throwaway scratch dir at the repo root (one-off debug, log dumps, prompt drafts)
TEMP/

# Agent scratch dir for one-off image/video step args and debug dumps
.mavis-tmp/

# Per-project novel/storyboard/user data — analogue to workspace/, never committed
/.short-drama/

# Host workbench memory — runtime state, not part of the repo
.workbuddy/

# Legacy local runtime databases
/db/
.ruff_cache/

# Per-machine Codex config: absolute interpreter paths differ per checkout location.
# hooks.json stays tracked because it resolves paths with `git rev-parse --show-toplevel`.
.codex/config.toml
