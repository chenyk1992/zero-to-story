{
  "schema": "short-drama.creative-handoff.v1",
  "project": {
    "title": "{drama_title}",
    "default_aspect_ratio": "9:16",
    "target_duration_ms": 45000,
    "language": "zh-CN",
    "visual_style": "wet-night neo-noir cinematic",
    "mood": "tense comedy unease"
  },
  "episode": {
    "episode_id": "ep{NNN}",
    "title": "{episode_title}",
    "source_path": ".short-drama/{drama_title}/episodes/ep{NNN}.md",
    "storyboard_brief_path": ".short-drama/{drama_title}/handoff/ep{NNN}/storyboard_brief.md",
    "cut_notes_path": ".short-drama/{drama_title}/handoff/ep{NNN}/cut_notes.md",
    "visual_summary": "{logline_cut}\n\n场景摘要：\n1) {scene_a_summary}\n2) {scene_b_summary}\n\n关键对白（精简）：\n- {key_line_1}\n- {key_line_2}\n\n视觉重点：{visual_beats}"
  },
  "panelization": {
    "min_duration_ms": 4000,
    "max_duration_ms": 15000,
    "notes": "由 zero-to-story 按场景因果和 Camera Setup 拆成多个 Panel；不要用固定镜头数或整集单 Clip 替代 Panel 计划。"
  },
  "audio_intent": {
    "dialogue": "{dialogue_intent}",
    "effects": "{effects_intent}",
    "external_voiceover": "{external_voiceover_intent}",
    "subtitle_requested": false
  },
  "origin": {
    "source": "user",
    "derived_from": [".short-drama/{drama_title}/episodes/ep{NNN}.md"],
    "reason": "短剧编剧 Skill /桥接 生成的创作侧简报；交给 zero-to-story，不直接交给 LFO。"
  }
}
