        "preferred_mode": "t2va",
        "notes": "首镜头 T2V"
      }
    }
  ]
}

ALLOWED ENUM VALUES (use these EXACT strings):

- camera.shot_size: extreme_close_up, close_up, medium, wide, extreme_wide
- camera.angle: eye_level, low, high, birds_eye, worms_eye
- camera.movement: static, pan, tilt, dolly, tracking, crane, handheld, slow_push_in, slow_pull_out
- characters[].screen_position: left, center, right, left_foreground, right_foreground,
  left_midground, right_midground, left_background, right_background,
  lower_left, lower_center, lower_right,
  upper_left, upper_center, upper_right
- characters[].orientation: facing_camera, facing_left, facing_right, back, profile
- generation_hint.preferred_family: h3_fl2va, h3_ref2va
- generation_hint.preferred_mode: t2va, i2v, first_last, r2v
- shot_id format: shot_NNN_<mode> where NNN is a 3-digit sequence
- scene_id format: scene_<short_id>
- prop_id format: prop_<short_id>
- continuity.priority: high, medium, low

Remember:
- The LITERAL first character of your response must be `{`.
- The LITERAL last character of your response must be `}`.
- Do NOT wrap the JSON in markdown code fences.
- Do NOT add any prose before or after the JSON.
