{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lfo.local/schemas/video-execution-v1.schema.json",
  "title": "VideoExecutionPackage v1",
  "description": "Sole public contract between Creative Skills and LFO.",
  "type": "object",
  "required": ["schema", "package_id", "revision", "project", "clips"],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "const": "lfo.video-execution.v1"
    },
    "package_id": {
      "$ref": "#/definitions/SafePathComponent"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "project": {
      "$ref": "#/definitions/ProjectInfo"
    },
    "assets": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/definitions/AssetSpec"
      }
    },
    "clips": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/ClipSpec"
      },
      "oneOf": [
        {
          "maxItems": 1
        },
        {
          "minItems": 2,
          "items": {
            "allOf": [
              {
                "$ref": "#/definitions/ClipSpec"
              },
              {
                "properties": {
                  "generation": {
                    "properties": {
                      "operation": {
                        "const": "video.passthrough"
                      }
                    },
                    "required": ["operation"]
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "output": {
      "$ref": "#/definitions/OutputPolicy",
      "default": {}
    },
    "approval": {
      "$ref": "#/definitions/ApprovalDeclaration",
      "default": {}
    },
    "timeline": {
      "$ref": "#/definitions/TimelineSpec"
    },
    "extensions": {
      "type": "object",
      "default": {},
      "properties": {
        "upscale": {
          "$ref": "#/definitions/UpscaleOptions"
        }
      },
      "additionalProperties": true
    }
  },
  "definitions": {
    "SafePathComponent": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s+$)(?!\\.{1,2}$)(?![\\s\\S]:)(?![\\s\\S]*[\\\\/\\u0000])(?![\\s\\S]*[ .]$)(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.[\\s\\S]*)?$)[\\s\\S]+$"
    },
    "PackageRelativeUri": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s+$)(?![\\\\/])(?![A-Za-z][A-Za-z0-9+.-]*:)(?!\\.\\.(?:[\\\\/]|$))(?![\\s\\S]*[\\\\/]\\.\\.(?:[\\\\/]|$))[\\s\\S]+$"
    },
    "ProjectInfo": {
      "type": "object",
      "required": ["title", "project_id"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "locale": { "type": ["string", "null"], "default": null },
        "project_id": { "$ref": "#/definitions/SafePathComponent" }
      }
    },
    "AssetSpec": {
      "type": "object",
      "required": ["asset_key", "media_type", "source", "provenance"],
      "additionalProperties": false,
      "properties": {
        "asset_key": { "type": "string", "minLength": 1 },
        "media_type": {
          "type": "string",
          "enum": ["image", "video", "audio", "subtitle", "document"]
        },
        "source": {
          "$ref": "#/definitions/AssetSource"
        },
        "provenance": {
          "$ref": "#/definitions/ProvenanceSpec"
        },
        "review": {
          "$ref": "#/definitions/ReviewDeclaration",
          "default": { "required": true }
        },
        "metadata": {
          "type": "object",
          "default": {},
          "additionalProperties": true
        }
      }
    },
    "AssetSource": {
      "type": "object",
      "required": ["uri"],
      "additionalProperties": false,
      "properties": {
        "uri": { "$ref": "#/definitions/PackageRelativeUri" },
        "sha256": { "type": ["string", "null"], "default": null }
      }
    },
    "ProvenanceSpec": {
      "type": "object",
      "required": ["source_type", "producer", "operation"],
      "additionalProperties": false,
      "properties": {
        "source_type": { "type": "string" },
        "producer": { "type": "string" },
        "operation": { "type": "string" },
        "producer_version": { "type": ["string", "null"], "default": null },
        "source_asset_keys": {
          "type": "array",
          "default": [],
          "items": { "type": "string" }
        },
        "prompt_hash": { "type": ["string", "null"], "default": null }
      }
    },
    "ReviewDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": { "type": "boolean", "default": true }
      }
    },
    "ClipSpec": {
      "type": "object",
      "required": ["clip_id", "sequence", "duration_ms", "generation"],
      "additionalProperties": false,
      "properties": {
        "clip_id": {
          "$ref": "#/definitions/SafePathComponent"
        },
        "sequence": { "type": "integer", "minimum": 1 },
        "duration_ms": { "type": "integer", "minimum": 1 },
        "generation": {
          "$ref": "#/definitions/GenerationSpec"
        },
        "audio": {
          "$ref": "#/definitions/AudioPolicy",
          "default": {}
        },
        "subtitles": {
          "$ref": "#/definitions/SubtitleSpec",
          "default": {}
        },
        "dependencies": {
          "type": "array",
          "default": [],
          "items": { "type": "string" }
        },
        "source_context": {
          "type": "object",
          "default": {},
          "additionalProperties": true
        },
        "extensions": {
          "type": "object",
          "default": {},
          "properties": {
            "upscale": {
              "$ref": "#/definitions/UpscaleOptions"
            }
          },
          "additionalProperties": true
        }
      }
    },
    "GenerationSpec": {
      "type": "object",
      "required": ["operation", "prompt"],
      "additionalProperties": false,
      "properties": {
        "operation": {
          "type": "string",
          "enum": [
            "video.text_to_video",
            "video.image_to_video",
            "video.reference_to_video",
            "video.first_last_frame",
            "video.virtual_presenter",
            "video.passthrough"
          ]
        },
        "prompt": { "type": "string", "minLength": 1 },
        "seed": { "type": ["integer", "null"], "default": null },
        "requirements": {
          "$ref": "#/definitions/GenerationRequirements",
          "default": {}
        },
        "references": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/definitions/ReferenceSpec"
          }
        }
      }
    },
    "GenerationRequirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "aspect_ratio": { "type": ["string", "null"], "default": null },
        "megapixels": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1.7976931348623157e308
            },
            {
              "type": "string",
              "minLength": 1,
              "pattern": "^\\s*\\+?(?:(?:\\d*[1-9]\\d*(?:\\.\\d*)?)|(?:0*\\.\\d*[1-9]\\d*))(?:[eE][+-]?\\d+)?\\s*$"
            },
            { "type": "null" }
          ],
          "default": null
        },
        "width": {
          "type": ["integer", "null"],
          "minimum": 1,
          "default": null
        },
        "height": {
          "type": ["integer", "null"],
          "minimum": 1,
          "default": null
        },
        "fps": {
          "type": ["integer", "null"],
          "minimum": 1,
          "default": null
        },
        "native_audio": { "type": ["string", "null"], "default": null },
        "reference_image_size": {
          "type": ["string", "null"],
          "enum": ["match", "max", null],
          "default": null
        }
      }
    },
    "ReferenceSpec": {
      "type": "object",
      "required": ["reference_id", "asset_key", "semantic_usage", "binding"],
      "additionalProperties": false,
      "properties": {
        "reference_id": { "type": "string", "minLength": 1 },
        "asset_key": { "type": "string", "minLength": 1 },
        "semantic_usage": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?=[\\s\\S]*\\S)[\\s\\S]+$"
        },
        "instruction": { "type": ["string", "null"], "default": null },
        "binding": {
          "$ref": "#/definitions/BindingPolicy"
        }
      }
    },
    "BindingPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": { "type": "boolean", "default": true },
        "priority": { "type": "integer", "default": 0 },
        "placement": {
          "type": "string",
          "enum": ["any", "first", "last", "fixed"],
          "default": "any"
        },
        "on_unsupported": {
          "type": "string",
          "enum": ["fail", "drop"],
          "default": "fail"
        },
        "slot": { "type": ["string", "null"], "default": null }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "placement": { "const": "fixed" }
            },
            "required": ["placement"]
          },
          "then": {
            "required": ["slot"],
            "properties": {
              "slot": { "type": "string", "minLength": 1 }
            }
          }
        },
        {
          "if": {
            "properties": {
              "on_unsupported": { "const": "drop" }
            },
            "required": ["on_unsupported"]
          },
          "then": {
            "required": ["required"],
            "properties": {
              "required": { "const": false }
            }
          }
        }
      ]
    },
    "AudioPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "native_audio": {
          "type": "string",
          "enum": ["preserve", "mute", "mix", "replace"],
          "default": "preserve"
        },
        "tracks": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/definitions/AudioTrackSpec"
          }
        }
      }
    },
    "AudioTrackSpec": {
      "type": "object",
      "required": ["asset_key", "role"],
      "additionalProperties": false,
      "properties": {
        "asset_key": { "type": "string", "minLength": 1 },
        "role": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?=[\\s\\S]*\\S)[\\s\\S]+$"
        },
        "offset_ms": { "type": "integer", "minimum": 0, "default": 0 },
        "gain_db": {
          "type": "string",
          "pattern": "^\\s*[+-]?(?:(?:\\d+(?:\\.\\d*)?)|(?:\\.\\d+))(?:[eE][+-]?\\d+)?\\s*$",
          "default": "0"
        },
        "fade_in_ms": { "type": "integer", "minimum": 0, "default": 0 },
        "fade_out_ms": { "type": "integer", "minimum": 0, "default": 0 },
        "duck_group": { "type": ["string", "null"], "default": null }
      }
    },
    "SubtitleSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cues": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/definitions/SubtitleCue"
          }
        },
        "asset_key": { "type": ["string", "null"], "default": null }
      }
    },
    "SubtitleCue": {
      "type": "object",
      "required": ["start_ms", "end_ms", "text"],
      "additionalProperties": false,
      "properties": {
        "start_ms": { "type": "integer", "minimum": 0 },
        "end_ms": { "type": "integer", "minimum": 0 },
        "text": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?=[\\s\\S]*\\S)[\\s\\S]+$"
        }
      }
    },
    "OutputPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "container": {
          "type": "string",
          "enum": ["mp4", "mov", "mkv", "webm"],
          "default": "mp4"
        },
        "video_encoder": {
          "type": "string",
          "enum": ["h264", "h265", "av1", "vp9"],
          "default": "h264"
        },
        "audio_encoder": {
          "type": "string",
          "enum": ["aac", "mp3", "opus", "flac", "pcm"],
          "default": "aac"
        },
        "width": { "type": ["integer", "null"], "minimum": 1, "default": null },
        "height": { "type": ["integer", "null"], "minimum": 1, "default": null },
        "fps": { "type": ["integer", "null"], "minimum": 1, "default": null },
        "sample_rate": { "type": ["integer", "null"], "minimum": 1, "default": null },
        "loudness_db": { "type": ["string", "null"], "default": null },
        "transitions": {
          "type": "string",
          "enum": ["cut"],
          "default": "cut"
        },
        "subtitles_mode": {
          "type": "string",
          "enum": ["none", "sidecar", "burnin", "both"],
          "default": "sidecar"
        },
        "directory": {
          "anyOf": [
            { "$ref": "#/definitions/SafePathComponent" },
            { "type": "null" }
          ],
          "default": null
        }
      }
    },
    "ApprovalDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "approved_by": { "type": ["string", "null"], "default": null },
        "approved_at": { "type": ["string", "null"], "default": null },
        "notes": { "type": ["string", "null"], "default": null }
      }
    },
    "TimelineSpec": {
      "type": "object",
      "required": ["segments"],
      "additionalProperties": false,
      "properties": {
        "segments": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TimelineSegment"
          }
        }
      }
    },
    "TimelineSegment": {
      "type": "object",
      "required": ["clip_id"],
      "additionalProperties": false,
      "properties": {
        "clip_id": {
          "$ref": "#/definitions/SafePathComponent"
        },
        "source_in_ms": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "source_out_ms": {
          "type": ["integer", "null"],
          "minimum": 1,
          "default": null
        }
      }
    },
    "UpscaleOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "scale_multiplier": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 2.0
        },
        "seed": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 18446744073709551615,
          "default": null
        }
      }
    }
  }
}
