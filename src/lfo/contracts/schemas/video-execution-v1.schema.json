{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lfo.local/schemas/video-execution-v1.schema.json",
  "title": "VideoExecutionPackage v1",
  "description": "Sole public contract between Creative Skills and LFO.",
  "type": "object",
  "required": ["schema", "package_id", "revision", "project", "assets", "clips", "output"],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "const": "lfo.video-execution.v1"
    },
    "package_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "project": {
      "$ref": "#/definitions/ProjectInfo"
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/AssetSpec"
      }
    },
    "clips": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ClipSpec"
      }
    },
    "output": {
      "$ref": "#/definitions/OutputPolicy"
    },
    "approval": {
      "$ref": "#/definitions/ApprovalDeclaration"
    },
    "timeline": {
      "type": "object"
    },
    "extensions": {
      "type": "object"
    }
  },
  "definitions": {
    "ProjectInfo": {
      "type": "object",
      "required": ["title"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "locale": { "type": "string" }
      }
    },
    "AssetSpec": {
      "type": "object",
      "required": ["asset_key", "media_type", "source", "provenance", "review"],
      "additionalProperties": false,
      "properties": {
        "asset_key": { "type": "string", "minLength": 1 },
        "media_type": {
          "type": "string",
          "enum": ["image", "video", "audio", "subtitle", "document"]
        },
        "source": {
          "$ref": "#/definitions/AssetSource"
        },
        "provenance": {
          "$ref": "#/definitions/ProvenanceSpec"
        },
        "review": {
          "$ref": "#/definitions/ReviewDeclaration"
        },
        "metadata": {
          "type": "object"
        }
      }
    },
    "AssetSource": {
      "type": "object",
      "required": ["uri"],
      "additionalProperties": false,
      "properties": {
        "uri": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string" }
      }
    },
    "ProvenanceSpec": {
      "type": "object",
      "required": ["source_type", "producer", "operation"],
      "additionalProperties": false,
      "properties": {
        "source_type": { "type": "string" },
        "producer": { "type": "string" },
        "operation": { "type": "string" },
        "producer_version": { "type": "string" },
        "source_asset_keys": {
          "type": "array",
          "items": { "type": "string" }
        },
        "prompt_hash": { "type": "string" }
      }
    },
    "ReviewDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": { "type": "boolean" }
      }
    },
    "ClipSpec": {
      "type": "object",
      "required": ["clip_id", "sequence", "duration_ms", "generation"],
      "additionalProperties": false,
      "properties": {
        "clip_id": { "type": "string", "minLength": 1 },
        "sequence": { "type": "integer" },
        "duration_ms": { "type": "integer", "minimum": 1 },
        "generation": {
          "$ref": "#/definitions/GenerationSpec"
        },
        "audio": {
          "$ref": "#/definitions/AudioPolicy"
        },
        "subtitles": {
          "$ref": "#/definitions/SubtitleSpec"
        },
        "dependencies": {
          "type": "array",
          "items": { "type": "string" }
        },
        "source_context": { "type": "object" },
        "extensions": { "type": "object" }
      }
    },
    "GenerationSpec": {
      "type": "object",
      "required": ["operation", "prompt", "requirements"],
      "additionalProperties": false,
      "properties": {
        "operation": { "type": "string", "minLength": 1 },
        "prompt": { "type": "string", "minLength": 1 },
        "negative_prompt": { "type": "string" },
        "seed": { "type": "integer" },
        "requirements": {
          "$ref": "#/definitions/GenerationRequirements"
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ReferenceSpec"
          }
        }
      }
    },
    "GenerationRequirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "aspect_ratio": { "type": "string" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "fps": { "type": "integer", "minimum": 1 },
        "native_audio": { "type": "string" }
      }
    },
    "ReferenceSpec": {
      "type": "object",
      "required": ["reference_id", "asset_key", "semantic_usage", "binding"],
      "additionalProperties": false,
      "properties": {
        "reference_id": { "type": "string", "minLength": 1 },
        "asset_key": { "type": "string", "minLength": 1 },
        "semantic_usage": { "type": "string" },
        "instruction": { "type": "string" },
        "binding": {
          "$ref": "#/definitions/BindingPolicy"
        }
      }
    },
    "BindingPolicy": {
      "type": "object",
      "required": ["required", "priority", "placement", "on_unsupported"],
      "additionalProperties": false,
      "properties": {
        "required": { "type": "boolean" },
        "priority": { "type": "integer" },
        "placement": {
          "type": "string",
          "enum": ["any", "first", "last", "fixed"]
        },
        "on_unsupported": {
          "type": "string",
          "enum": ["fail", "drop"]
        },
        "slot": { "type": "string" }
      }
    },
    "AudioPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "native_audio": {
          "type": "string",
          "enum": ["preserve", "mute", "mix", "replace"]
        },
        "tracks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AudioTrackSpec"
          }
        }
      }
    },
    "AudioTrackSpec": {
      "type": "object",
      "required": ["asset_key", "role"],
      "additionalProperties": false,
      "properties": {
        "asset_key": { "type": "string", "minLength": 1 },
        "role": { "type": "string" },
        "offset_ms": { "type": "integer" },
        "gain_db": { "type": "string" },
        "fade_in_ms": { "type": "integer" },
        "fade_out_ms": { "type": "integer" },
        "duck_group": { "type": "string" }
      }
    },
    "SubtitleSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cues": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SubtitleCue"
          }
        },
        "asset_key": { "type": "string" }
      }
    },
    "SubtitleCue": {
      "type": "object",
      "required": ["start_ms", "end_ms", "text"],
      "additionalProperties": false,
      "properties": {
        "start_ms": { "type": "integer" },
        "end_ms": { "type": "integer" },
        "text": { "type": "string" }
      }
    },
    "OutputPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "container": {
          "type": "string",
          "enum": ["mp4", "mov", "mkv", "webm"]
        },
        "video_encoder": {
          "type": "string",
          "enum": ["h264", "h265", "av1", "vp9"]
        },
        "audio_encoder": {
          "type": "string",
          "enum": ["aac", "mp3", "opus", "flac", "pcm"]
        },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "fps": { "type": "integer", "minimum": 1 },
        "sample_rate": { "type": "integer", "minimum": 1 },
        "loudness_db": { "type": "string" },
        "transitions": { "type": "string" },
        "subtitles_mode": {
          "type": "string",
          "enum": ["sidecar", "burnin", "both"]
        },
        "directory": { "type": "string" }
      }
    },
    "ApprovalDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "approved_by": { "type": "string" },
        "approved_at": { "type": "string" },
        "notes": { "type": "string" }
      }
    }
  }
}
