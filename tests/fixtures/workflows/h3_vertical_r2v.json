{
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "minimax_h3_ref2va_pruned_int8_convrot.safetensors",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "type": "minimax"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_video_vae_fp16.safetensors"
    }
  },
  "4": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_audio_vae_fp32.safetensors"
    }
  },
  "5": {
    "class_type": "ResolutionSelector",
    "inputs": {
      "aspect_ratio": "9:16 (Portrait Widescreen)",
      "megapixels": 0.33,
      "multiple": 32
    }
  },
  "6": {
    "_meta": {"title": "LFO.Reference01"},
    "class_type": "LoadImage",
    "inputs": {
      "image": "ref_0.png"
    }
  },
  "7": {
    "_meta": {"title": "LFO.Reference02"},
    "class_type": "LoadImage",
    "inputs": {
      "image": "ref_1.png"
    }
  },
  "8": {
    "_meta": {"title": "LFO.Reference03"},
    "class_type": "LoadImage",
    "inputs": {
      "image": "ref_2.png"
    }
  },
  "9": {
    "_meta": {"title": "LFO.Prompt"},
    "class_type": "PrimitiveStringMultiline",
    "inputs": {
      "value": "test r2v prompt with <Picture 1> <Picture 2> <Picture 3>"
    }
  },
  "10": {
    "_meta": {"title": "LFO.Duration"},
    "class_type": "PrimitiveFloat",
    "inputs": {
      "value": 5
    }
  },
  "11": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "expression": "max(5, round(a * 24)) + (5 - (max(5, round(a * 24)) % 17)) % 17",
      "values.a": ["10", 0]
    }
  },
  "12": {
    "_meta": {"title": "LFO.MainGenerator"},
    "class_type": "MiniMaxH3ReferenceToVideo",
    "inputs": {
      "clip": ["2", 0],
      "vae": ["3", 0],
      "audio_vae": ["4", 0],
      "prompt": ["9", 0],
      "width": ["5", 0],
      "height": ["5", 1],
      "length": ["11", 1],
      "ref_image_size": "match",
      "ref_images.ref_image_0": ["6", 0],
      "ref_images.ref_image_1": ["7", 0],
      "ref_images.ref_image_2": ["8", 0]
    }
  },
  "13": {
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "res_multistep"
    }
  },
  "14": {
    "class_type": "BasicScheduler",
    "inputs": {
      "scheduler": "simple",
      "steps": 20,
      "denoise": 1.0,
      "model": ["1", 0]
    }
  },
  "15": {
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": 12345
    }
  },
  "16": {
    "class_type": "BasicGuider",
    "inputs": {
      "model": ["1", 0],
      "conditioning": ["12", 0]
    }
  },
  "17": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["15", 0],
      "guider": ["16", 0],
      "sampler": ["13", 0],
      "sigmas": ["14", 0],
      "latent_image": ["12", 1]
    }
  },
  "18": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["17", 0],
      "vae": ["3", 0]
    }
  },
  "19": {
    "class_type": "VAEDecodeAudio",
    "inputs": {
      "samples": ["17", 0],
      "vae": ["4", 0]
    }
  },
  "20": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["18", 0],
      "fps": 24,
      "audio": ["19", 0]
    }
  },
  "21": {
    "_meta": {"title": "LFO.SaveVideo"},
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["20", 0],
      "filename_prefix": "video/test_r2v_vertical",
      "format": "mp4",
      "codec": "h264"
    }
  }
